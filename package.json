{
  "name": "litedaemon",
  "version": "1.0.0",
  "description": "LiteDaemon — OpenRouter for AI Agents and Tools",
  "private": true,
  "scripts": {
    "build": "npm run build:api && npm run build:dashboard",
    "build:api": "cd apps/api && npm run build",
    "build:dashboard": "cd apps/dashboard && npm run build",
    "dev:api": "cd apps/api && npm run dev",
    "dev:dashboard": "cd apps/dashboard && npm run dev"
  },
  "workspaces": [
    "apps/*"
  ]
}
